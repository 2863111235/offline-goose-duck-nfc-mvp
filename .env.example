# Local server
HOST=0.0.0.0
PORT=3000

# Replace with the computer's real LAN IPv4 before writing NFC tags.
PUBLIC_BASE_URL=http://192.168.1.20:3000

# Local-only persistence
DATABASE_PATH=./data/goose-duck.sqlite

# Replace before the first run. Never commit the real value.
SESSION_SECRET=replace-with-a-long-random-value

# Local referee login. Change before a real session.
ADMIN_PIN=2468

# Game rule defaults; all durations are seconds.
KILL_COOLDOWN_SECONDS=300
TASK_COOLDOWN_SECONDS=180
OPENING_PROTECTION_SECONDS=0

# Prevent stale confirmation pages from being submitted much later.
NFC_CONFIRM_WINDOW_SECONDS=120
